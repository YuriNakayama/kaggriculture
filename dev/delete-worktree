#!/bin/bash
set -euo pipefail

# Remove a git worktree created by dev/create-worktree.
#
# Usage:
#   dev/delete-worktree                 # from inside a worktree: remove it
#   dev/delete-worktree <branch-name>   # by name, from anywhere
#   dev/delete-worktree --list          # show removable worktrees
#
# Warns about uncommitted and unpushed work before removing, and offers to
# delete the branch afterwards. The main worktree can never be removed.
#
# data/ is a symlink to the main repo, so removing a worktree never deletes
# the shared lake — `git worktree remove` unlinks it rather than following it.

WORKTREE_BASE_SUFFIX=".worktrees"

MAIN_WORKTREE="$(git worktree list --porcelain | awk '/^worktree /{print $2; exit}')"
WORKTREE_BASE="${MAIN_WORKTREE}${WORKTREE_BASE_SUFFIX}"

usage() {
  cat <<EOF
Usage:
  dev/delete-worktree                 # from inside a worktree: remove it
  dev/delete-worktree <branch-name>   # by branch name or directory name
  dev/delete-worktree --list          # list removable worktrees

Worktrees live in: ${WORKTREE_BASE}/<dir-name>
EOF
}

case "${1:-}" in
  --list | -l)
    echo "Worktrees (excluding main):"
    git worktree list | tail -n +2 || true
    exit 0
    ;;
  --help | -h)
    usage
    exit 0
    ;;
esac

if [ $# -ge 1 ]; then
  ARG="$1"
  DIR_NAME="${ARG//\//-}"
  TARGET_PATH="${WORKTREE_BASE}/${DIR_NAME}"

  # Fall back to a branch-name match so worktrees created outside the
  # conventional base directory can still be removed.
  if [ ! -d "$TARGET_PATH" ]; then
    MATCH="$(git worktree list --porcelain |
      awk -v b="refs/heads/${ARG}" '
        /^worktree /{p=substr($0,10)}
        /^branch /{if ($2==b) print p}')"
    if [ -n "$MATCH" ]; then
      TARGET_PATH="$MATCH"
    else
      echo "Error: no such worktree: ${ARG}" >&2
      echo "  looked in: ${TARGET_PATH}" >&2
      echo "" >&2
      git worktree list | tail -n +2 >&2 || true
      exit 1
    fi
  fi
  TARGET_PATH="$(cd "$TARGET_PATH" && pwd)"
  BRANCH_NAME="$(git -C "$TARGET_PATH" rev-parse --abbrev-ref HEAD)"
else
  REPO_ROOT="$(git rev-parse --show-toplevel)"
  if [ "$REPO_ROOT" = "$MAIN_WORKTREE" ]; then
    echo "Error: refusing to run without an argument in the main worktree." >&2
    echo "" >&2
    usage >&2
    exit 1
  fi
  TARGET_PATH="$REPO_ROOT"
  BRANCH_NAME="$(git rev-parse --abbrev-ref HEAD)"
fi

if [ "$TARGET_PATH" = "$MAIN_WORKTREE" ]; then
  echo "Error: cannot remove the main worktree: $TARGET_PATH" >&2
  exit 1
fi

echo "About to remove:"
echo "  path:   $TARGET_PATH"
echo "  branch: $BRANCH_NAME"
echo ""

if ! git -C "$TARGET_PATH" diff --quiet || ! git -C "$TARGET_PATH" diff --cached --quiet; then
  echo "Warning: uncommitted changes present:"
  git -C "$TARGET_PATH" status --short
  echo ""
fi

UPSTREAM="origin/${BRANCH_NAME}"
if git rev-parse --verify --quiet "$UPSTREAM" >/dev/null 2>&1; then
  UNPUSHED="$(git -C "$TARGET_PATH" log "${UPSTREAM}..HEAD" --oneline 2>/dev/null || true)"
  if [ -n "$UNPUSHED" ]; then
    echo "Warning: unpushed commits:"
    echo "$UNPUSHED"
    echo ""
  fi
else
  echo "Warning: branch '${BRANCH_NAME}' has never been pushed."
  echo ""
fi

read -r -p "Remove this worktree? [y/N]: " confirm
if [[ ! "$confirm" =~ ^[Yy]$ ]]; then
  echo "Cancelled."
  exit 0
fi

# Undo the skip-worktree bits set by create-worktree before removing, so the
# index is left in a clean state even if `git worktree remove` bails out.
DATA_TRACKED="$(git -C "$TARGET_PATH" ls-files -- data 2>/dev/null || true)"
if [ -n "$DATA_TRACKED" ]; then
  printf '%s\n' "$DATA_TRACKED" |
    xargs -I{} git -C "$TARGET_PATH" update-index --no-skip-worktree -- "{}" \
      2>/dev/null || true
fi

# Step out of the target before removing it.
cd "$MAIN_WORKTREE"
git worktree remove "$TARGET_PATH" --force

echo ""
echo "Removed worktree: $TARGET_PATH"

read -r -p "Also delete branch '${BRANCH_NAME}'? [y/N]: " confirm_branch
if [[ "$confirm_branch" =~ ^[Yy]$ ]]; then
  if git branch -d "$BRANCH_NAME" 2>/dev/null; then
    echo "Deleted branch: $BRANCH_NAME"
  else
    echo "Warning: branch has unmerged commits."
    read -r -p "Force delete? [y/N]: " force_confirm
    if [[ "$force_confirm" =~ ^[Yy]$ ]]; then
      git branch -D "$BRANCH_NAME"
      echo "Force-deleted branch: $BRANCH_NAME"
    else
      echo "Kept branch: $BRANCH_NAME"
    fi
  fi
fi
