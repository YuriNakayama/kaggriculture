#!/bin/bash
# RunPod GPU pod control.
#
#   dev/runpod train --case case1 ...   # launch training on a rented pod
#   dev/runpod dev                      # interactive pod for debugging
#   dev/runpod ps | stock | pull | promote | cost-report
#
# Requires the optional GPU deps: dev/setup --gpu
set -euo pipefail
cd "$(dirname "$0")/.."
exec uv run --directory backend python -m gpu.runpod "$@"
