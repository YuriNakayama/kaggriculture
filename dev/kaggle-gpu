#!/bin/bash
# Kaggle Kernel GPU training (free-tier alternative to RunPod).
#
#   dev/kaggle-gpu train --case case1 --watch
#   dev/kaggle-gpu ps | status | logs | pull | promote
#
# Requires the optional GPU deps: dev/setup --gpu
set -euo pipefail
cd "$(dirname "$0")/.."
exec uv run --directory backend python -m gpu.kaggle "$@"
